{
  "name": "membership_allocation_client_module",
  "version": "0.3.0",
  "description": "RLN membership allocation client: requests a membership from an allocator over a libp2p node of its own, with auth produced by pluggable auth_vector modules",
  "author": "Logos",
  "type": "core",
  "interface": "cdylib",
  "category": "blockchain",
  "main": "membership_allocation_client_module_plugin",
  "dependencies": [],
  "include": [],
  "capabilities": [],
  "codegen": {
    "rust": {
      "crate": "rust-lib",
      "trait": "MembershipAllocationClientModule"
    }
  },
  "nix": {
    "external_libraries": [
      {
        "name": "libp2p",
        "vendor_path": "lib"
      }
    ],
    "packages": {
      "build": [],
      "runtime": [
        "nlohmann_json"
      ]
    },
    "cmake": {
      "find_packages": [],
      "extra_include_dirs": [
        "lib"
      ]
    },
    "platforms": [
      {
        "when": {
          "os": "linux"
        },
        "packages": {
          "runtime": [
            "tinycbor"
          ]
        }
      },
      {
        "when": {
          "os": "darwin"
        },
        "packages": {
          "runtime": [
            "tinycbor"
          ]
        }
      },
      {
        "when": {
          "os": "windows"
        },
        "rust": {
          "toolchain": "1.94.0"
        }
      }
    ]
  }
}
